#!/usr/bin/env bash
#
# A stand-in for systemctl, enough for deploy.sh: one unit, the fixture app,
# run in the background from the deploy root. stub.env next to it says where.

set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=/dev/null
. "$here/stub.env"   # PREFIX PORT RUN

cmd="$1"
shift
[[ "${1:-}" == --quiet ]] && shift
svc="$1"
pidfile="$RUN/$svc.pid"

alive() { [[ -f "$pidfile" ]] && kill -0 "$(cat "$pidfile")" 2>/dev/null; }

case "$cmd" in
    restart)
        if alive; then
            kill "$(cat "$pidfile")"
            while alive; do sleep 0.1; done
        fi
        echo "$svc" >> "$RUN/restarts"
        cd "$PREFIX"
        setsid python3 app.py "$PORT" > "$RUN/$svc.log" 2>&1 < /dev/null &
        echo $! > "$pidfile"
        ;;
    is-active)  alive ;;
    is-enabled) [[ -f "$RUN/$svc.enabled" ]] ;;
    *) echo "stub systemctl: $cmd is not supported" >&2; exit 1 ;;
esac
